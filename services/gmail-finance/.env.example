# Run npm run init to create .env with random encryption and API keys.
PORT=4318
DATA_DIR=./data
SERVICE_API_KEY=
ENCRYPTION_KEY=
# Google OAuth Web application credentials; enable the Gmail API first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4318/oauth/callback
GOOGLE_ALLOWED_EMAIL=
HOME_CURRENCY=USD
TIME_ZONE=America/Los_Angeles
# Optional. Without these, conservative deterministic parsing + review runs locally.
# Setting these sends normalized email content to Anthropic for extraction.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
MODEL_DAILY_CALL_LIMIT=100
POLL_INTERVAL_SECONDS=900
